{
  "crucible-domain-map": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/crucible_gate.py session-start",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/crucible_gate.py pre-tool",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
